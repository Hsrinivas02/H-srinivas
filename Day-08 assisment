package pom;

import java.io.FileInputStream;
import java.io.IOException;
import java.time.Duration;
import java.util.Properties;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;

public class orangeTest {

    public static void main(String[] args) throws IOException {


        // ==========================================
        // PROPERTY FILE
        // ==========================================

        FileInputStream f = new FileInputStream(
                "./src/test/resources/sample/prop.properties");

        Properties p = new Properties();

        p.load(f);


        String brow = p.getProperty("browser");

        String url = p.getProperty("url");

        String un = p.getProperty("username");

        String pw = p.getProperty("password");


        String firstName = p.getProperty("FirstName");

        String middleName = p.getProperty("MiddleName");

        String lastName = p.getProperty("LastName");


        String vacancyData = p.getProperty("Vacancy");

        String email = p.getProperty("Email");

        String mobile = p.getProperty("Mobile");


        String resumePath = p.getProperty("ResumePath");


        String applicationDate = p.getProperty("ApplicationDate");


        String jobTitleData = p.getProperty("JobTitle");

        String hiringManagerData = p.getProperty("HiringManager");

        String statusData = p.getProperty("Status");


        // ==========================================
        // BROWSER
        // ==========================================

        WebDriver driver = null;

        if (brow.equalsIgnoreCase("chrome")) {

            driver = new ChromeDriver();
        }


        driver.manage().window().maximize();

        driver.manage().timeouts().implicitlyWait(
                Duration.ofSeconds(15));

        driver.get(url);


        // ==========================================
        // POM OBJECT
        // ==========================================

        orange r = new orange(driver);


        // ==========================================
        // LOGIN

        // ==========================================
        // JOB VACANCY
        // ==========================================

        r.getJobVacancy();

        driver.findElement(By.xpath(
                "//div[@role='option']//span[normalize-space()='"
                        + vacancyData + "']"))
                .click();


        // ==========================================
        // HIRING MANAGER
        // ==========================================

        r.getHiringManager();

        driver.findElement(By.xpath(
